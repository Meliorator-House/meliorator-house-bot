{
  "version": 2,
  "functions": {
    "api/webhook.py": {
      "runtime": "vercel-python@4.1.0",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/webhook.py"
    }
  ]
}
